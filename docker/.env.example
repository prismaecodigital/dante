# Copy to docker/.env and fill in the secrets: `make env`, then `make key`.
# This file is read by the compose files (via --env-file in the Makefile) and,
# in development, passed to the containers as their environment.

# --- Application -----------------------------------------------------------
APP_NAME=DATEK
APP_KEY=
APP_URL=http://localhost:8080
APP_DOMAIN=dante.example.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# --- Database --------------------------------------------------------------
DB_CONNECTION=mysql
DB_DATABASE=dante
DB_USERNAME=dante
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root-secret
MYSQL_VERSION=8.0

# --- Development host ports (change when they are already taken) -----------
APP_PORT=8080
VITE_PORT=5173
ADMINER_PORT=8081
DB_HOST_PORT=3307
VITE_HMR_HOST=localhost
VITE_VUE_APP_I18N_LOCALE=id
VITE_VUE_APP_I18N_FALLBACK_LOCALE=id

# --- Runtime ---------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
RUN_MIGRATIONS=true
CACHE_CONFIG=false

# --- Mail ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@dante.example.com
MAIL_FROM_NAME=${APP_NAME}

# --- Sanctum ---------------------------------------------------------------
# Must contain the exact host:port you browse the SPA with.
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080

# --- Production / Traefik --------------------------------------------------
APP_NETWORK=dante-internal
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
ADMINER_VERSION=4.8.1
APP_IMAGE=prismaeco/dante-app:prod
NGINX_IMAGE=prismaeco/dante-nginx:prod

# --- Build -----------------------------------------------------------------
PHP_VERSION=8.5.12
NODE_VERSION=26.12.1
COMPOSER_VERSION=2.11.1
NGINX_VERSION=1.27-alpine
